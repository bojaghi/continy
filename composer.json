{
  "name": "bojaghi/continy",
  "description": "Re-usable tiny container for WordPress themes and plugins.",
  "homepage": "https://github.com/bojaghi/continy",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
  },
  "autoload-dev": {
  },
  "authors": [
    {
      "name": "changwoo",
      "email": "ep6tri@hotmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "bojaghi/contract": "^2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "yoast/phpunit-polyfills": "^4",
    "bojaghi/wp-tests": "^1.0",
    "bojaghi/dictionary": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "alleyinteractive/wordpress-autoloader": "^1.2"
  },
  "scripts": {
  },
  "version": "2.0.0",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-autoloader": {
      "autoload": {
        "Bojaghi\\Continy\\": "inc/"
      }
    }
  }
}
